# ---------------------------------------------------------------
# Private data — the original Sephora CSV files must NEVER be committed
# ---------------------------------------------------------------
# Dataset folders are anchored to the repo root (a leading "/") so they do not
# also match source packages such as backend/app/data/.
/data/
/datasets/
/archive/
*.csv
*.parquet
*.feather
*.pkl
*.zip
# Sentiment label store and any other local databases (derived from private data)
*.sqlite
*.sqlite3
*.db
*.npz
# Synthetic, safe test fixtures are the only CSVs allowed
!backend/tests/fixtures/*.csv

# ---------------------------------------------------------------
# Secrets / environment
# ---------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets/

