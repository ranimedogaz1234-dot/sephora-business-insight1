# Copy to backend/.env and adjust. Never commit the real .env file.
SBI_ENVIRONMENT=development
# Absolute path to the folder containing product_info.csv and reviews_*.csv.
# Keep the private dataset OUTSIDE the repository.
SBI_DATA_DIR=C:/path/to/sephora/archive
# Persistent Parquet cache of the prepared dataset (derived private data, gitignored).
SBI_CACHE_DIR=.cache
SBI_CACHE_ENABLED=true
# Also verify SHA-256 of the CSVs when validating the cache (slower startup).
SBI_CACHE_VERIFY_HASH=false
# Load the dataset at server start instead of on the first data request.
SBI_PRELOAD=true
# JSON list of allowed frontend origins
SBI_CORS_ORIGINS=["http://localhost:3001","http://127.0.0.1:3001"]

# --- AI sentiment (optional) ---------------------------------------------------
# Classification runs only from the CLI (python -m app.sentiment.cli), never from the API.
# Your Anthropic API key. Keep it here (backend/.env, gitignored) - never in the frontend.
ANTHROPIC_API_KEY=
# Model, effort and reviews per request. Prices for the cost estimate: app/sentiment/pricing.py
SBI_SENTIMENT_MODEL=claude-opus-5-5
SBI_SENTIMENT_EFFORT=low
SBI_SENTIMENT_GROUP_SIZE=20
# Label store (SQLite). Default: <SBI_CACHE_DIR>/sentiment.sqlite3 (gitignored)
# SBI_SENTIMENT_DB=
